{
  "name": "vrms-server",
  "version": "0.3.0",
  "description": "VRMS Backend",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "lint": "biome lint .",
    "format": "biome format --check .",
    "test": "vitest run",
    "test:unit": "vitest run --exclude 'routers/**' --exclude 'test/**'",
    "test:integration": "vitest run routers/ test/",
    "test:watch": "vitest",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "client": "npm run start --prefix client",
    "heroku-postbuild": "cd client && npm install && npm run build",
    "clone-or-sync-projects": "node ./scripts/cloneOrSyncCollections.js",
    "clear-dev-collections": "node ./scripts/clearDevCollections.js",
    "swagger": "node ./scripts/swagger-autogen.js"
  },
  "author": "sarL3y",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^10.0.6",
    "debug": "^4.4.3",
    "mockdate": "^3.0.5",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1",
    "swagger-autogen": "^2.23.7",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "why-is-node-running": "^3.2.3"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@slack/bolt": "^5.1.0",
    "assert-env": "^0.6.0",
    "async": "^3.2.6",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "dotenv-expand": "^13.0.0",
    "express": "^5.3.0",
    "express-validator": "^7.3.2",
    "googleapis": "^185.0.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb-memory-server": "^11.3.0",
    "mongoose": "^9.11.2",
    "morgan": "^1.12.1",
    "node-cron": "^4.6.0",
    "node-fetch": "^3.3.2",
    "nodemailer": "^10.1.0",
    "posthog-node": "^5.55.3",
    "swagger-ui-express": "^5.0.1"
  },
  "directories": {
    "test": "test"
  }
}
