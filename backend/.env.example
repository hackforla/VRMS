# Contact the VRMS team for the below values
DATABASE_URL=
CUSTOM_REQUEST_HEADER=
SLACK_OAUTH_TOKEN=
SLACK_BOT_TOKEN=
SLACK_TEAM_ID=
SLACK_CHANNEL_ID=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
BACKEND_PORT=4000
REACT_APP_PROXY=http://localhost:${BACKEND_PORT}
GMAIL_CLIENT_ID=
GMAIL_SECRET_ID=
GMAIL_REFRESH_TOKEN=
GMAIL_EMAIL=vrms.signup@gmail.com
MAILHOG_PORT=1025
MAILHOG_USER=user
MAILHOG_PASSWORD=
NODE_ENV=test

# Optional: Login v2 (/api/auth/v2, built on Better Auth). The app starts without these;
# v2 routes answer 503 until both of the first two are set. See "Login v2" in backend/README.md.
# AUTH_V2_SECRET=                   # at least 32 random characters, e.g. `openssl rand -base64 48`
# AUTH_V2_BASE_URL=http://localhost:3000   # the public origin of the site (client and API share it), no path
# AUTH_V2_SIGNIN_LIMIT=10           # sign-in/sign-up requests per IP per minute (default 10)
